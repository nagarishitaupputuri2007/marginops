# MarginOps Environment Configuration Template
# Copy this file to .env for local development

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# PostgreSQL (Relational Database & Financial Ledgers)
POSTGRES_USER=marginops
POSTGRES_PASSWORD=marginops_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marginops

# MongoDB (Telemetry, Metrics & Event Logs)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=marginops_telemetry

# Redis (Caching & Celery Broker)
REDIS_URL=redis://localhost:6379/0

# Celery (Background Worker Queue)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
